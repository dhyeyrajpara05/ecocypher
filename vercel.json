{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/api/(state|rpc)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/pyodide/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
